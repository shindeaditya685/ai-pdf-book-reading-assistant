# ── Required ──────────────────────────────────────────────────────────────

# MongoDB connection string
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/pdfmindai

# JWT signing secret — MUST be set in production (the app fails fast if missing).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-hex-secret

# ── AI Providers (at least one required) ──────────────────────────────────

# Groq — comma-separated for multi-key failover
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Google Gemini (fallback)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxx

# NVIDIA hosted models (used by lib/ai-client.ts)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────

# Set to 'false' to disable AI quota enforcement (not recommended in production)
AI_QUOTA_ENABLED=true

# ── Object storage (S3-compatible: Supabase Storage / Cloudflare R2) ──────
# PDF binaries are stored here instead of MongoDB (Mongo keeps only metadata).
#
# Supabase Storage (free 1GB, no credit card):
#   Project Settings → Storage → enable S3 Access → create Access Keys.
#   Create a bucket (e.g. "pdfs") in the dashboard, then set:
#     S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#     S3_BUCKET_NAME=pdfs
#
# Cloudflare R2 (free 10GB, requires a card to enable):
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_BUCKET_NAME=<your-bucket>
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret
S3_BUCKET_NAME=pdfs
# Path-style addressing (required for Supabase, also works with R2). Set to false only if your endpoint requires virtual-hosted style.
S3_FORCE_PATH_STYLE=true
